        <script>
        const Webamp = window.Webamp;

        const webamp = new Webamp({

            initialSkin: {
                url: "assets/skins/illumina.wsz"
            },
            availableSkins: [
                { url: "assets/skins/C10k2_-_Carbo_KAI.wsz", name: "carbo kai" },
