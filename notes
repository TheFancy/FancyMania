            ],
            initialTracks: [
            {
              metaData: {
                artist: "Slowerpace 音楽",
                title: "Lost in space 宇宙の冒険.mp3"
              },
                url: "assets/music/Slowerpace.mp3",
                duration: 180 // duration in seconds (optional)
            }
            ]
        });

        // Render when ready
        webamp.renderWhenReady(document.getElementById('webamp'));
        </script>



